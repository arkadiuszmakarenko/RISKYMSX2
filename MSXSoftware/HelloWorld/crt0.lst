                                      1 ;-------------------------------------------------------------------------------
                                      2 ; crt0.s - C runtime startup for an MSX ROM cartridge
                                      3 ;
                                      4 ; Placed at 0x4000 (page 1). The "AB" header tells the MSX BIOS that a ROM
                                      5 ; cartridge is present; the INIT vector makes it auto-start at power-on
                                      6 ; (called via CALSLT on the main-ROM interrupt, with interrupts disabled
                                      7 ; and the stack near the top of RAM).
                                      8 ;-------------------------------------------------------------------------------
                                      9 
                                     10 	.module crt0
                                     11 	.globl	_main
                                     12 
                                     13 	.area	_HEADER (ABS)
                                     14 
      004000                         15 	.org	0x4000
                                     16 
                                     17 	;; --- MSX ROM header (16 bytes) ---
      004000 41 42                   18 	.db	0x41, 0x42		; 'A' 'B' cartridge ID
      004002r10r40                   19 	.dw	init			; INIT: auto-start entry point
      004004 00 00                   20 	.dw	0x0000			; STATEMENT: no new BASIC statements
      004006 00 00                   21 	.dw	0x0000			; DEVICE: no new devices
      004008 00 00                   22 	.dw	0x0000			; TEXT: no BASIC program in ROM
      00400A 00 00 00 00 00 00       23 	.dw	0x0000, 0x0000, 0x0000	; reserved
                                     24 
                                     25 	;; --- Entry point ---
      004010                         26 init:
      004010 CDr00r00         [17]   27 	call	_main
                                     28 	;; _main does not return if the program ends in an endless loop,
                                     29 	;; but if it does, clean up: disable screen interrupts and RET to BIOS
      004013 F3               [ 4]   30 	di
      004014 76               [ 4]   31 	halt
      004015 C9               [10]   32 	ret
