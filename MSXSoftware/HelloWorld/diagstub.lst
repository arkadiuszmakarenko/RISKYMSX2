                                      1 ; diagstub.s - fixed-address data block for the psramdiag ROM.
                                      2 ;
                                      3 ; Places a 256-byte walking pattern at exactly Z80 address 0x5000
                                      4 ; (PATTERN_ADDR), inside the cart page 0x4000..0xBFFF, so psramdiag.c
                                      5 ; can reference it at a FIXED address - that lets the logic analyzer
                                      6 ; trigger on the address bus alone (A=0x50xx).
                                      7 ;
                                      8 ; Pattern formula: byte[i] = i ^ 0xA5   (matches psramdiag.c PH4 and
                                      9 ; tools/rom2c.py's integrity pre-check).
                                     10 ;
                                     11 ; PH1 reads 0x5000, PH3 reads 0x5040, PH5 reads 0x5080 - all inside
                                     12 ; this pattern, each with a distinct expected data byte (0xA5 / 0xE5 /
                                     13 ; 0x25) usable as a second LA qualifier.
                                     14 ;
                                     15 ; Code (.area _CODE at --code-loc 0x4020) stays well below 0x5000, so
                                     16 ; there is no overlap with this block. Assembled with sdasz80.
                                     17 
                                     18 	.module diagstub
                                     19 
                                     20 	; own ABS area: linker places it at the absolute address below
                                     21 	; without merging it into crt0's _HEADER chunk at 0x4000.
                                     22 	.area	_DIAG (ABS)
                                     23 
      005000                         24 	.org	0x5000
      005000                         25 _pattern:
      005000 A5 A4 A7 A6 A1 A0 A3    26 	.db	0xA5, 0xA4, 0xA7, 0xA6, 0xA1, 0xA0, 0xA3, 0xA2
             A2
      005008 AD AC AF AE A9 A8 AB    27 	.db	0xAD, 0xAC, 0xAF, 0xAE, 0xA9, 0xA8, 0xAB, 0xAA
             AA
      005010 B5 B4 B7 B6 B1 B0 B3    28 	.db	0xB5, 0xB4, 0xB7, 0xB6, 0xB1, 0xB0, 0xB3, 0xB2
             B2
      005018 BD BC BF BE B9 B8 BB    29 	.db	0xBD, 0xBC, 0xBF, 0xBE, 0xB9, 0xB8, 0xBB, 0xBA
             BA
      005020 85 84 87 86 81 80 83    30 	.db	0x85, 0x84, 0x87, 0x86, 0x81, 0x80, 0x83, 0x82
             82
      005028 8D 8C 8F 8E 89 88 8B    31 	.db	0x8D, 0x8C, 0x8F, 0x8E, 0x89, 0x88, 0x8B, 0x8A
             8A
