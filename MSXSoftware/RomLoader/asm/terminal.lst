                                      1 ;-------------------------------------------------------------------------------
                                      2 ; terminal.asm - MSX-side terminal ROM for RISKYMSX2 (CH32V407).
                                      3 ;
                                      4 ; Ported from v303firmwaer/MSXTerminal/msxterminal.asm (sjasmplus syntax) to
                                      5 ; sdasz80 syntax so it builds with the existing MSXSoftware/RomLoader
                                      6 ; toolchain (sdcc + sdasz80 + makebin).
                                      7 ;
                                      8 ; Layout, mailbox semantics, and screen I/O are byte-for-byte identical to
                                      9 ; v303 (the firmware side expects the same protocol - see cart.c
                                     10 ; Cart_EXTI0_Terminal_Handler).
                                     11 ;
                                     12 ; Mailbox at the cart edge:
                                     13 ;
                                     14 ;   0x7FFD  WRITE   - keyboard byte (firmware pops the byte, decides key)
                                     15 ;   0x7FFE  WRITE   - control byte
                                     16 ;                        0x00 = "boot gate: GRAPH held -> terminal menu"
                                     17 ;                        0x01 = "boot gate: GRAPH not held -> boot Nextor"
                                     18 ;                        0x04 = legacy v303 "user held GRPH" (ignored)
                                     19 ;   0x7FFF  READ    - firmware output FIFO (CHAR by CHAR; 0 = empty, the
                                     20 ;                     byte itself is the printable character; 0x03 = "user
                                     21 ;                     asked to abort / soft-reset the MSX into ROM");
                                     22 ;                     0x04 = "move the menu cursor" (followed by reading
                                     23 ;                     X-then-Y bytes).
                                     24 ;
                                     25 ; For RISKYMSX2 the firmware also recognises a few extra control codes that
                                     26 ; the v303 firmware did not need:
                                     27 ;
                                     28 ;   0x7FF0..0x7FF7  READ  - "USB stick presence" status (1 byte = "stick
                                     29 ;                           present", 0 = "no stick yet")
                                     30 ;
                                     31 ; Boot flow:
                                     32 ;   1. INIT probes the GRAPH key (SNSMAT row 6, bit 2) and tells the
                                     33 ;      firmware which path to take on 0x7FFE BEFORE it starts polling:
                                     34 ;        - GRAPH held     -> 0x00: full terminal menu.
                                     35 ;        - GRAPH not held -> 0x01: boot Nextor directly.
                                     36 ;      The firmware gates its first menu render on this byte, so a
                                     37 ;      no-GRAPH power-on goes straight to Nextor with no menu flash.
                                     38 ;   2. INIT then copies the post-init body to RAM at 0xE000. The body
                                     39 ;      length is a fixed constant (BODY_SIZE bytes).
                                     40 ;   3. Set 32-column screen, palette, sprite cursor, then loop:
                                     41 ;      read 0x7FFF, print whatever the firmware puts there, poll keyboard
                                     42 ;      and forward each keystroke on 0x7FFD.
                                     43 ;-------------------------------------------------------------------------------
                                     44 
                                     45         .module terminal
                                     46 
                                     47 ;-------------------------------------------------------------------------------
                                     48 ; Empty _DATA area. sdcc's linker emits a spurious
                                     49 ; "No definition of area _DATA" warning (which it returns exit code 1
                                     50 ; for) when a standalone asm binary has no .data section. Declaring an
                                     51 ; empty area here silences both the warning and the exit code without
                                     52 ; affecting the binary output.
                                     53 ;-------------------------------------------------------------------------------
                                     54         .area _DATA
      000000                         55         .ds 1
                                     56 
                                     57 ;-------------------------------------------------------------------------------
                                     58 ; ROM header - "AB" + INIT pointer, then ID/version strings.
                                     59 ;-------------------------------------------------------------------------------
                                     60         .area   _HEADER (ABS)
      004000                         61         .org    0x4000
                                     62 
                                     63         ;; --- MSX ROM header (16 bytes) ---
      004000 41 42                   64         .db     0x41, 0x42              ; 'A' 'B' cartridge ID
      004002r10r40                   65         .dw     init                    ; INIT: auto-start entry point
      004004 00 00                   66         .dw     0x0000                  ; STATEMENT
      004006 00 00                   67         .dw     0x0000                  ; DEVICE
      004008 00 00                   68         .dw     0x0000                  ; TEXT
      00400A 00 00 00 00 00 00       69         .dw     0x0000, 0x0000, 0x0000  ; reserved
                                     70 
                                     71         ;; --- INIT body at 0x4010 ---
                                     72         ;; The MSX BIOS calls init() during ROM probing. init() copies
                                     73         ;; a fixed-size body (BODY_SIZE bytes) from ROM to MSX RAM at
                                     74         ;; 0xE000, then JP into RAM. Same trick as v303 - the cart may
                                     75         ;; swap itself out for the user's cart image before we are done
                                     76         ;; printing, so we run from RAM.
      004010                         77         .org    0x4010
      004010                         78 init:
                                     79         ;; Boot gate. Probe the GRAPH key via the BIOS SNSMAT matrix
                                     80         ;; reader (entry 0x0141 - it is SNSMAT, not GTSIZE). Row 6,
                                     81         ;; bit 2, active-low: 0 = held. Tell the firmware the decision
                                     82         ;; on 0x7FFE BEFORE copying/running the body, so the firmware
                                     83         ;; main loop can skip the menu render and go straight to
                                     84         ;; Nextor on a no-GRAPH power-on.
      004010 3E 06            [ 7]   85         ld      a, #6
      004012 CD 41 01         [17]   86         call    0x0141                  ; SNSMAT - A = row, returns matrix
      004015 E6 04            [ 7]   87         and     #0x04                   ; GRAPH = row 6 bit 2, 0 = held
      004017 28 07            [12]   88         jr      z, bg_terminal          ; held -> terminal menu
                                     89         ;; GRAPH not held -> ask the firmware to boot Nextor.
      004019 3E 01            [ 7]   90         ld      a, #0x01
      00401B 32 FE 7F         [13]   91         ld      (0x7FFE), a
      00401E 18 05            [12]   92         jr      bg_run
      004020                         93 bg_terminal:
                                     94         ;; GRAPH held -> full terminal menu.
      004020 3E 00            [ 7]   95         ld      a, #0x00
      004022 32 FE 7F         [13]   96         ld      (0x7FFE), a
      004025                         97 bg_run:
      004025 21r33r40         [10]   98         ld      hl, #body              ; source in ROM
      004028 11 00 E0         [10]   99         ld      de, #0xE000            ; destination in MSX RAM
      00402B 01 B6 00         [10]  100         ld      bc, #BODY_SIZE         ; byte count
      00402E ED B0            [21]  101         ldir
      004030 C3 00 E0         [10]  102         jp      0xE000                 ; jump into the relocated copy
                                    103 
                                    104 ;-------------------------------------------------------------------------------
                                    105 ; Body to copy to RAM. Same shape as v303: screen setup,
                                    106 ; poll-FIFO + forward-keyboard loop, ROM_START path.
                                    107 ;
                                    108 ; IMPORTANT: do NOT use .org here - let the assembler place body right
                                    109 ; after the init code. The .org 0x401D in the previous version collided
                                    110 ; with the trailing byte of the JP 0xE000 instruction (3 bytes ending
                                    111 ; at 0x401D), so body actually got placed at 0x401E while LDIR still
                                    112 ; pointed at 0x401D - that one-byte offset meant the RAM copy started
                                    113 ; with the trailing E0 of the JP, which Z80 decodes as RET PO. RET PO
                                    114 ; sometimes returns to a random stack address, which is exactly the
                                    115 ; "rubbish on screen / doesn't drop to BASIC" symptom. Letting the
                                    116 ; assembler place body sequentially keeps the LDIR source correct.
                                    117 ;-------------------------------------------------------------------------------
      004033                        118 body:
                                    119         ;; The GRAPH boot gate ran in init() (see above); by the time
                                    120         ;; control reaches here the firmware already knows whether to
                                    121         ;; render the menu or boot Nextor. Just initialise the screen +
                                    122         ;; cursor and enter the main loop.
                                    123 
                                    124         ;; Relocate the 5-byte launch patch to a FIXED MSX RAM address
                                    125         ;; (0xE100). The BIOS executes it later - after the firmware
                                    126         ;; has swapped the cart mapper away from this ROM - so a
                                    127         ;; ROM-resident patch would fetch game bytes as code. The
                                    128         ;; v303 original solved this with PHASE #E000 (all body labels
                                    129         ;; resolved to RAM); the sdasz80 port keeps ROM addresses, so
                                    130         ;; the copy is explicit. Body RAM base = 0xE000 (body ROM
                                    131         ;; base is whatever the assembler assigns, currently 0x4033),
                                    132         ;; so 0xE100 is well clear of the copy.
      004033 21rD3r40         [10]  133         ld      hl, #ugly_patch
      004036 11 00 E1         [10]  134         ld      de, #0xE100
      004039 01 05 00         [10]  135         ld      bc, #5
      00403C ED B0            [21]  136         ldir
                                    137 
                                    138         ;; Set 32-column screen, palette, sprite cursor.
      00403E 3E 20            [ 7]  139         ld      a, #32
      004040 32 AF F3         [13]  140         ld      (0xF3AF), a
      004043 21 0F 00         [10]  141         ld      hl, #0x000F
      004046 22 EA F3         [16]  142         ld      (0xF3EA), hl
      004049 22 E9 F3         [16]  143         ld      (0xF3E9), hl
      00404C 3E 01            [ 7]  144         ld      a, #1
      00404E CD 5F 00         [17]  145         call    0x005F
      004051 21rF0r40         [10]  146         ld      hl, #arrow
      004054 11 00 38         [10]  147         ld      de, #0x3800
      004057 01 08 00         [10]  148         ld      bc, #8
      00405A CD 5C 00         [17]  149         call    0x005C
      00405D 3E 08            [ 7]  150         ld      a, #8
      00405F 21 03 1B         [10]  151         ld      hl, #0x1B03
      004062 CD 4D 00         [17]  152         call    0x004D
                                    153         ;; Initialise sprite 0 properly. v303 only wrote 8 to 0x1B03
                                    154         ;; (the unused attribute byte on MSX1) and relied on the
                                    155         ;; pattern index at 0x1B02 being zero - which is only true
                                    156         ;; on cold boot. After other carts or sprites use 0x1B02 the
                                    157         ;; arrow shows whatever pattern sits at the stale index.
                                    158         ;; Force pattern index = 0 (arrow lives at VRAM 0x3800) and
                                    159         ;; start with the sprite hidden (Y = 0) so a stale VRAM Y
                                    160         ;; doesn't show junk before the firmware's first 0x04 push.
      004065 3E 00            [ 7]  161         ld      a, #0                   ; pattern index 0 = arrow @ 0x3800
      004067 21 02 1B         [10]  162         ld      hl, #0x1B02
      00406A CD 4D 00         [17]  163         call    0x004D
      00406D 3E 00            [ 7]  164         ld      a, #0                   ; Y = 0 = sprite hidden
      00406F 21 00 1B         [10]  165         ld      hl, #0x1B00
      004072 CD 4D 00         [17]  166         call    0x004D
      004075 3E 01            [ 7]  167         ld      a, #1                   ; X = 1 (off-screen) - hidden by Y first
      004077 21 01 1B         [10]  168         ld      hl, #0x1B01
      00407A CD 4D 00         [17]  169         call    0x004D
                                    170 
      00407D                        171 loop:
                                    172         ;; Poll firmware FIFO at 0x7FFF.
      00407D 3A FF 7F         [13]  173         ld      a, (0x7FFF)
      004080 FE 03            [ 7]  174         cp      #3
      004082 28 2B            [12]  175         jr      z, rom_start            ; "boot the cart"
      004084 FE 04            [ 7]  176         cp      #4
      004086 28 14            [12]  177         jr      z, sprite               ; "move the cursor"
      004088 A7               [ 4]  178         and     a
      004089 CCrDEr40         [17]  179         call    z, wait                 ; empty -> wait one refresh
      00408C C4 A2 00         [17]  180         call    nz, 0x00A2              ; non-empty -> CHPUT (BIOS print)
                                    181         ;; Poll keyboard and forward on 0x7FFD.
      00408F CD 9C 00         [17]  182         call    0x009C                  ; CHSNS - any key?
      004092 28 E9            [12]  183         jr      z, loop
      004094 CD 9F 00         [17]  184         call    0x009F                  ; CHGET - read key
      004097 32 FD 7F         [13]  185         ld      (0x7FFD), a
      00409A 18 E1            [12]  186         jr      loop
                                    187 
      00409C                        188 sprite:
      00409C 3A FF 7F         [13]  189         ld      a, (0x7FFF)             ; X
      00409F 21 01 1B         [10]  190         ld      hl, #0x1B01
      0040A2 CD 4D 00         [17]  191         call    0x004D
      0040A5 3A FF 7F         [13]  192         ld      a, (0x7FFF)             ; Y
      0040A8 3D               [ 4]  193         dec     a
      0040A9 2D               [ 4]  194         dec     l
      0040AA CD 4D 00         [17]  195         call    0x004D
      0040AD 18 CE            [12]  196         jr      loop
                                    197 
      0040AF                        198 rom_start:
                                    199         ;; >= ~35 ms for the firmware to settle: wait two JIFFY ticks.
                                    200         ;; INLINED and executed from MSX RAM - no cart access from
                                    201         ;; here on (the firmware swaps the mapper during this window;
                                    202         ;; a `call wait` would fetch the swapped-in cart's bytes).
      0040AF FB               [ 4]  203         ei
      0040B0 21 9E FC         [10]  204         ld      hl, #0xFC9E             ; JIFFY
      0040B3 7E               [ 7]  205         ld      a, (hl)
      0040B4                        206 rs_w1:
      0040B4 BE               [ 7]  207         cp      (hl)
      0040B5 28 FD            [12]  208         jr      z, rs_w1                ; jiffy change #1
      0040B7 7E               [ 7]  209         ld      a, (hl)
      0040B8                        210 rs_w2:
      0040B8 BE               [ 7]  211         cp      (hl)
      0040B9 28 FD            [12]  212         jr      z, rs_w2                ; ... and #2
      0040BB 2A B1 F6         [16]  213         ld      hl, (0xF6B1)
      0040BE 11 F4 FF         [10]  214         ld      de, #-12
      0040C1 19               [11]  215         add     hl, de
      0040C2 E5               [11]  216         push    hl
      0040C3 5E               [ 7]  217         ld      e, (hl)
      0040C4 23               [ 6]  218         inc     hl
      0040C5 56               [ 7]  219         ld      d, (hl)
      0040C6 21 A3 7D         [10]  220         ld      hl, #0x7DA3
      0040C9 E7               [11]  221         rst     #0x20                   ; COMPARE HL, DE (BIOS helper)
      0040CA E1               [10]  222         pop     hl
      0040CB 20 0B            [12]  223         jr      nz, unknown
                                    224         ;; Patch the BIOS INIT-return frame to 0xE100 (little-endian
                                    225         ;; 00 E1): the launch patch executes from MSX RAM, safe under
                                    226         ;; the mapper swap.
      0040CD 36 00            [10]  227         ld      (hl), #0x00
      0040CF 23               [ 6]  228         inc     hl
      0040D0 36 E1            [10]  229         ld      (hl), #0xE1
      0040D2 C9               [10]  230         ret
                                    231 
      0040D3                        232 ugly_patch:
      0040D3 C1               [10]  233         pop     bc
      0040D4 E1               [10]  234         pop     hl
      0040D5 C3 84 7D         [10]  235         jp      0x7D84
                                    236 
      0040D8                        237 unknown:
      0040D8 1E 52            [ 7]  238         ld      e, #'R'
      0040DA CD B1 FF         [17]  239         call    0xFFB1
      0040DD C7               [11]  240         rst     0
                                    241 
      0040DE                        242 wait:
      0040DE F5               [11]  243         push    af
      0040DF FB               [ 4]  244         ei
      0040E0 21 9E FC         [10]  245         ld      hl, #0xFC9E             ; JIFFY
      0040E3 7E               [ 7]  246         ld      a, (hl)
      0040E4                        247 wait_loop:
      0040E4 BE               [ 7]  248         cp      (hl)
      0040E5 28 FD            [12]  249         jr      z, wait_loop
      0040E7 F1               [10]  250         pop     af
      0040E8 C9               [10]  251         ret
      0040E9                        252 body_end:
                                    253 
                           0000B6   254 BODY_SIZE = body_end - body
                                    255 
                                    256 ;-------------------------------------------------------------------------------
                                    257 ; Cursor arrow sprite pattern - sits just past the relocated body.
                                    258 ;-------------------------------------------------------------------------------
      0040F0                        259         .org    0x40F0
      0040F0                        260 arrow:
      0040F0 20                     261         .db     0b00100000
      0040F1 30                     262         .db     0b00110000
      0040F2 38                     263         .db     0b00111000
      0040F3 3C                     264         .db     0b00111100
      0040F4 38                     265         .db     0b00111000
      0040F5 30                     266         .db     0b00110000
      0040F6 20                     267         .db     0b00100000
      0040F7 00                     268         .db     0b00000000
