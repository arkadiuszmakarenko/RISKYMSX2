                                      1 ;-------------------------------------------------------------------------------
                                      2 ; terminal.asm - MSX-side terminal ROM for RISKYMSX2 (CH32V407).
                                      3 ;
                                      4 ; Ported from v303firmwaer/MSXTerminal/msxterminal.asm (sjasmplus syntax) to
                                      5 ; sdasz80 syntax so it builds with the existing MSXSoftware/RomLoader
                                      6 ; toolchain (sdcc + sdasz80 + makebin).
                                      7 ;
                                      8 ; Layout, mailbox semantics, and screen I/O are byte-for-byte identical to
                                      9 ; v303 (the firmware side expects the same protocol - see cart.c
                                     10 ; Cart_EXTI0_Terminal_Handler).
                                     11 ;
                                     12 ; Mailbox at the cart edge:
                                     13 ;
                                     14 ;   0x7FFD  WRITE   - keyboard byte (firmware pops the byte, decides key)
                                     15 ;   0x7FFE  WRITE   - control byte
                                     16 ;                        0x00 = "boot gate: GRAPH held -> terminal menu"
                                     17 ;                        0x01 = "boot gate: GRAPH not held -> boot Nextor"
                                     18 ;                        0x04 = legacy v303 "user held GRPH" (ignored)
                                     19 ;   0x7FFF  READ    - firmware output FIFO (CHAR by CHAR; 0 = empty, the
                                     20 ;                     byte itself is the printable character; 0x03 = "user
                                     21 ;                     asked to abort / soft-reset the MSX into ROM");
                                     22 ;                     0x04 = "move the menu cursor" (followed by reading
                                     23 ;                     X-then-Y bytes).
                                     24 ;
                                     25 ; For RISKYMSX2 the firmware also recognises a few extra control codes that
                                     26 ; the v303 firmware did not need:
                                     27 ;
                                     28 ;   0x7FF0..0x7FF7  READ  - "USB stick presence" status (1 byte = "stick
                                     29 ;                           present", 0 = "no stick yet")
                                     30 ;
                                     31 ; Boot flow:
                                     32 ;   1. INIT probes the GRAPH key (SNSMAT row 6, bit 2) and tells the
                                     33 ;      firmware which path to take on 0x7FFE BEFORE it starts polling:
                                     34 ;        - GRAPH held     -> 0x00: full terminal menu.
                                     35 ;        - GRAPH not held -> 0x01: boot Nextor directly.
                                     36 ;      The firmware gates its first menu render on this byte, so a
                                     37 ;      no-GRAPH power-on goes straight to Nextor with no menu flash.
                                     38 ;   2. INIT then copies the post-init body to RAM at 0xE000. The body
                                     39 ;      length is a fixed constant (BODY_SIZE bytes).
                                     40 ;   3. Set 32-column screen, palette, sprite cursor, then loop:
                                     41 ;      read 0x7FFF, print whatever the firmware puts there, poll keyboard
                                     42 ;      and forward each keystroke on 0x7FFD.
                                     43 ;-------------------------------------------------------------------------------
                                     44 
                                     45         .module terminal
                                     46 
                                     47 ;-------------------------------------------------------------------------------
                                     48 ; Empty _DATA area. sdcc's linker emits a spurious
                                     49 ; "No definition of area _DATA" warning (which it returns exit code 1
                                     50 ; for) when a standalone asm binary has no .data section. Declaring an
                                     51 ; empty area here silences both the warning and the exit code without
                                     52 ; affecting the binary output.
                                     53 ;-------------------------------------------------------------------------------
                                     54         .area _DATA
      000000                         55         .ds 1
                                     56 
                                     57 ;-------------------------------------------------------------------------------
                                     58 ; ROM header - "AB" + INIT pointer, then ID/version strings.
                                     59 ;-------------------------------------------------------------------------------
                                     60         .area   _HEADER (ABS)
      004000                         61         .org    0x4000
                                     62 
                                     63         ;; --- MSX ROM header (16 bytes) ---
      004000 41 42                   64         .db     0x41, 0x42              ; 'A' 'B' cartridge ID
      004002r10r40                   65         .dw     init                    ; INIT: auto-start entry point
      004004 00 00                   66         .dw     0x0000                  ; STATEMENT
      004006 00 00                   67         .dw     0x0000                  ; DEVICE
      004008 00 00                   68         .dw     0x0000                  ; TEXT
      00400A 00 00 00 00 00 00       69         .dw     0x0000, 0x0000, 0x0000  ; reserved
                                     70 
                                     71         ;; --- INIT body at 0x4010 ---
                                     72         ;; The MSX BIOS calls init() during ROM probing. init() copies
                                     73         ;; a fixed-size body (BODY_SIZE bytes) from ROM to MSX RAM at
                                     74         ;; 0xE000, then JP into RAM. Same trick as v303 - the cart may
                                     75         ;; swap itself out for the user's cart image before we are done
                                     76         ;; printing, so we run from RAM.
      004010                         77         .org    0x4010
      004010                         78 init:
                                     79         ;; Boot gate. Probe the GRAPH key via the BIOS SNSMAT matrix
                                     80         ;; reader (entry 0x0141 - it is SNSMAT, not GTSIZE). Row 6,
                                     81         ;; bit 2, active-low: 0 = held. Tell the firmware the decision
                                     82         ;; on 0x7FFE BEFORE copying/running the body, so the firmware
                                     83         ;; main loop can skip the menu render and go straight to
                                     84         ;; Nextor on a no-GRAPH power-on.
      004010 3E 06            [ 7]   85         ld      a, #6
      004012 CD 41 01         [17]   86         call    0x0141                  ; SNSMAT - A = row, returns matrix
      004015 E6 04            [ 7]   87         and     #0x04                   ; GRAPH = row 6 bit 2, 0 = held
      004017 28 07            [12]   88         jr      z, bg_terminal          ; held -> terminal menu
                                     89         ;; GRAPH not held -> ask the firmware to boot Nextor.
      004019 3E 01            [ 7]   90         ld      a, #0x01
      00401B 32 FE 7F         [13]   91         ld      (0x7FFE), a
      00401E 18 05            [12]   92         jr      bg_run
      004020                         93 bg_terminal:
                                     94         ;; GRAPH held -> full terminal menu.
      004020 3E 00            [ 7]   95         ld      a, #0x00
      004022 32 FE 7F         [13]   96         ld      (0x7FFE), a
      004025                         97 bg_run:
      004025 21r33r40         [10]   98         ld      hl, #body              ; source in ROM
      004028 11 00 E0         [10]   99         ld      de, #0xE000            ; destination in MSX RAM
      00402B 01 97 00         [10]  100         ld      bc, #BODY_SIZE         ; byte count
      00402E ED B0            [21]  101         ldir
      004030 C3 00 E0         [10]  102         jp      0xE000                 ; jump into the relocated copy
                                    103 
                                    104 ;-------------------------------------------------------------------------------
                                    105 ; Body to copy to RAM. Same shape as v303: screen setup,
                                    106 ; poll-FIFO + forward-keyboard loop, ROM_START path.
                                    107 ;
                                    108 ; IMPORTANT: do NOT use .org here - let the assembler place body right
                                    109 ; after the init code. The .org 0x401D in the previous version collided
                                    110 ; with the trailing byte of the JP 0xE000 instruction (3 bytes ending
                                    111 ; at 0x401D), so body actually got placed at 0x401E while LDIR still
                                    112 ; pointed at 0x401D - that one-byte offset meant the RAM copy started
                                    113 ; with the trailing E0 of the JP, which Z80 decodes as RET PO. RET PO
                                    114 ; sometimes returns to a random stack address, which is exactly the
                                    115 ; "rubbish on screen / doesn't drop to BASIC" symptom. Letting the
                                    116 ; assembler place body sequentially keeps the LDIR source correct.
                                    117 ;-------------------------------------------------------------------------------
      004033                        118 body:
                                    119         ;; The GRAPH boot gate ran in init() (see above); by the time
                                    120         ;; control reaches here the firmware already knows whether to
                                    121         ;; render the menu or boot Nextor. Just initialise the screen +
                                    122         ;; cursor and enter the main loop.
                                    123 
                                    124         ;; Set 32-column screen, palette, sprite cursor.
      004033 3E 20            [ 7]  125         ld      a, #32
      004035 32 AF F3         [13]  126         ld      (0xF3AF), a
      004038 21 0F 00         [10]  127         ld      hl, #0x000F
      00403B 22 EA F3         [16]  128         ld      (0xF3EA), hl
      00403E 22 E9 F3         [16]  129         ld      (0xF3E9), hl
      004041 3E 01            [ 7]  130         ld      a, #1
      004043 CD 5F 00         [17]  131         call    0x005F
      004046 21rCAr40         [10]  132         ld      hl, #arrow
      004049 11 00 38         [10]  133         ld      de, #0x3800
      00404C 01 08 00         [10]  134         ld      bc, #8
      00404F CD 5C 00         [17]  135         call    0x005C
      004052 3E 08            [ 7]  136         ld      a, #8
      004054 21 03 1B         [10]  137         ld      hl, #0x1B03
      004057 CD 4D 00         [17]  138         call    0x004D
                                    139         ;; Initialise sprite 0 properly. v303 only wrote 8 to 0x1B03
                                    140         ;; (the unused attribute byte on MSX1) and relied on the
                                    141         ;; pattern index at 0x1B02 being zero - which is only true
                                    142         ;; on cold boot. After other carts or sprites use 0x1B02 the
                                    143         ;; arrow shows whatever pattern sits at the stale index.
                                    144         ;; Force pattern index = 0 (arrow lives at VRAM 0x3800) and
                                    145         ;; start with the sprite hidden (Y = 0) so a stale VRAM Y
                                    146         ;; doesn't show junk before the firmware's first 0x04 push.
      00405A 3E 00            [ 7]  147         ld      a, #0                   ; pattern index 0 = arrow @ 0x3800
      00405C 21 02 1B         [10]  148         ld      hl, #0x1B02
      00405F CD 4D 00         [17]  149         call    0x004D
      004062 3E 00            [ 7]  150         ld      a, #0                   ; Y = 0 = sprite hidden
      004064 21 00 1B         [10]  151         ld      hl, #0x1B00
      004067 CD 4D 00         [17]  152         call    0x004D
      00406A 3E 01            [ 7]  153         ld      a, #1                   ; X = 1 (off-screen) - hidden by Y first
      00406C 21 01 1B         [10]  154         ld      hl, #0x1B01
      00406F CD 4D 00         [17]  155         call    0x004D
                                    156 
                                    157         ;; Disable the BIOS function-key display (equivalent to
                                    158         ;; BASIC's `KEY OFF`). In text screen modes the BIOS draws
                                    159         ;; the default F1-F10 macros ("color", "auto", "goto",
                                    160         ;; "list", "run", ...) on the bottom screen line by default,
                                    161         ;; and redraws them on screen events - that line lands under
                                    162         ;; the terminal footer, so the macros keep reappearing over
                                    163         ;; the menu. CNSDFG (0xF3DE) = 0 means "hidden" (see
                                    164         ;; Nextor's msx_workarea.h); FNKSB (0x00C9) erases the
                                    165         ;; currently displayed line. Must run AFTER CHGMOD, which
                                    166         ;; is what draws it in the first place.
      004072 3E 00            [ 7]  167         ld      a, #0
      004074 32 DE F3         [13]  168         ld      (0xF3DE), a
      004077 CD C9 00         [17]  169         call    0x00C9                  ; FNKSB - erase the key display
                                    170 
      00407A                        171 loop:
                                    172         ;; Poll firmware FIFO at 0x7FFF.
      00407A 3A FF 7F         [13]  173         ld      a, (0x7FFF)
      00407D FE 03            [ 7]  174         cp      #3
      00407F 28 31            [12]  175         jr      z, rom_start            ; "boot the cart"
      004081 FE 04            [ 7]  176         cp      #4
      004083 28 14            [12]  177         jr      z, sprite               ; "move the cursor"
      004085 A7               [ 4]  178         and     a
      004086 CCrBFr40         [17]  179         call    z, wait                 ; empty -> wait one refresh
      004089 C4 A2 00         [17]  180         call    nz, 0x00A2              ; non-empty -> CHPUT (BIOS print)
                                    181         ;; Poll keyboard and forward on 0x7FFD.
      00408C CD 9C 00         [17]  182         call    0x009C                  ; CHSNS - any key?
      00408F 28 E9            [12]  183         jr      z, loop
      004091 CD 9F 00         [17]  184         call    0x009F                  ; CHGET - read key
      004094 32 FD 7F         [13]  185         ld      (0x7FFD), a
      004097 18 E1            [12]  186         jr      loop
                                    187 
      004099                        188 sprite:
                                    189         ;; The firmware pushes 0x04, X then Y as three separate FIFO
                                    190         ;; writes. An EXTI0 can therefore hand us the 0x04 before X/Y
                                    191         ;; are queued; reading 0x7FFF while empty returns 0x00, which
                                    192         ;; would be taken as a real coordinate and shift the cursor off
                                    193         ;; the text stream (stray cursor jumps / partial screens).
                                    194         ;; Both coordinates are never 0 (col*8+1 and row*8+1), so spin
                                    195         ;; until a nonzero byte arrives before consuming it.
      004099                        196 spr_x:
      004099 3A FF 7F         [13]  197         ld      a, (0x7FFF)             ; X
      00409C A7               [ 4]  198         and     a
      00409D 28 FA            [12]  199         jr      z, spr_x
      00409F 21 01 1B         [10]  200         ld      hl, #0x1B01
      0040A2 CD 4D 00         [17]  201         call    0x004D
      0040A5                        202 spr_y:
      0040A5 3A FF 7F         [13]  203         ld      a, (0x7FFF)             ; Y
      0040A8 A7               [ 4]  204         and     a
      0040A9 28 FA            [12]  205         jr      z, spr_y
      0040AB 3D               [ 4]  206         dec     a
      0040AC 2D               [ 4]  207         dec     l
      0040AD CD 4D 00         [17]  208         call    0x004D
      0040B0 18 C8            [12]  209         jr      loop
                                    210 
      0040B2                        211 rom_start:
                                    212         ;; >= ~35 ms for the firmware to settle: wait two JIFFY ticks.
                                    213         ;; FULLY INLINED and executed from MSX RAM - no cart access from
                                    214         ;; here on. The firmware swaps the mapper ~20 ms after pushing
                                    215         ;; the 0x03, i.e. DURING this wait; a `call wait` would fetch the
                                    216         ;; swapped-in cart's bytes as code (wait lives at a cart-window
                                    217         ;; address, and the swap lands mid-wait-loop - the Z80 then
                                    218         ;; executes garbage and the MSX hangs: exactly the bug the inline
                                    219         ;; exists to prevent).
      0040B2 FB               [ 4]  220         ei
      0040B3 21 9E FC         [10]  221         ld      hl, #0xFC9E             ; JIFFY
      0040B6 7E               [ 7]  222         ld      a, (hl)
      0040B7                        223 rs_w1:
      0040B7 BE               [ 7]  224         cp      (hl)
      0040B8 28 FD            [12]  225         jr      z, rs_w1                ; jiffy change #1
      0040BA 7E               [ 7]  226         ld      a, (hl)
      0040BB                        227 rs_w2:
      0040BB BE               [ 7]  228         cp      (hl)
      0040BC 28 FD            [12]  229         jr      z, rs_w2                ; ... and #2
                                    230         ;; Reboot: plain BIOS-standard RST 0 cold start. The target
                                    231         ;; mapper is already installed (the swap landed during the wait
                                    232         ;; above), so the BIOS slot probe finds the new ROM's 'AB'.
                                    233         ;; This replaces the v303 BIOS stack-layout patch (compare the
                                    234         ;; INIT return against 0x7DA3, patch the frame to the 0xE100
                                    235         ;; stub, jp 0x7D84) - those are BIOS-version-specific addresses,
                                    236         ;; and RST 0 is equivalent because the hard-reset test proved a
                                    237         ;; plain cold boot works on this machine.
      0040BE C7               [11]  238         rst     0
                                    239 
      0040BF                        240 wait:
      0040BF F5               [11]  241         push    af
      0040C0 FB               [ 4]  242         ei
      0040C1 21 9E FC         [10]  243         ld      hl, #0xFC9E             ; JIFFY
      0040C4 7E               [ 7]  244         ld      a, (hl)
      0040C5                        245 wait_loop:
      0040C5 BE               [ 7]  246         cp      (hl)
      0040C6 28 FD            [12]  247         jr      z, wait_loop
      0040C8 F1               [10]  248         pop     af
      0040C9 C9               [10]  249         ret
      0040CA                        250 body_end:
                                    251 
                           000097   252 BODY_SIZE = body_end - body
                                    253 
                                    254 ;-------------------------------------------------------------------------------
                                    255 ; Cursor arrow sprite pattern - emitted immediately after the body. It used to
                                    256 ; sit at a hard-coded .org 0x40F0; when the body grew past that address the
                                    257 ; assembler overwrote the trailing `ret` of `wait`, hanging the body (no keys,
                                    258 ; no boot). Letting it follow body_end keeps the two from ever colliding; it
                                    259 ; still lands inside the 256-byte trimmed cartridge window.
                                    260 ;-------------------------------------------------------------------------------
      0040CA                        261 arrow:
      0040CA 20                     262         .db     0b00100000
      0040CB 30                     263         .db     0b00110000
      0040CC 38                     264         .db     0b00111000
      0040CD 3C                     265         .db     0b00111100
      0040CE 38                     266         .db     0b00111000
      0040CF 30                     267         .db     0b00110000
      0040D0 20                     268         .db     0b00100000
      0040D1 00                     269         .db     0b00000000
