                                      1 ;-------------------------------------------------------------------------------
                                      2 ; terminal.asm - MSX-side terminal ROM for RISKYMSX2 (CH32V407).
                                      3 ;
                                      4 ; Ported from v303firmwaer/MSXTerminal/msxterminal.asm (sjasmplus syntax) to
                                      5 ; sdasz80 syntax so it builds with the existing MSXSoftware/RomLoader
                                      6 ; toolchain (sdcc + sdasz80 + makebin).
                                      7 ;
                                      8 ; Layout, mailbox semantics, and screen I/O are byte-for-byte identical to
                                      9 ; v303 (the firmware side expects the same protocol - see cart.c
                                     10 ; Cart_EXTI0_Terminal_Handler).
                                     11 ;
                                     12 ; Mailbox at the cart edge:
                                     13 ;
                                     14 ;   0x7FFD  WRITE   - keyboard byte (firmware pops the byte, decides key)
                                     15 ;   0x7FFE  WRITE   - control byte
                                     16 ;                        0x00 = "continue / terminal menu"
                                     17 ;                        0x04 = "user held GRPH - skip the terminal, boot
                                     18 ;                                the cart image straight away"
                                     19 ;   0x7FFF  READ    - firmware output FIFO (CHAR by CHAR; 0 = empty, the
                                     20 ;                     byte itself is the printable character; 0x03 = "user
                                     21 ;                     asked to abort / soft-reset the MSX into ROM");
                                     22 ;                     0x04 = "move the menu cursor" (followed by reading
                                     23 ;                     X-then-Y bytes).
                                     24 ;
                                     25 ; For RISKYMSX2 the firmware also recognises a few extra control codes that
                                     26 ; the v303 firmware did not need:
                                     27 ;
                                     28 ;   0x7FF0..0x7FF7  READ  - "USB stick presence" status (1 byte = "stick
                                     29 ;                           present", 0 = "no stick yet")
                                     30 ;
                                     31 ; Boot flow:
                                     32 ;   1. INIT moves the post-init body to RAM at 0xE000. The body length is
                                     33 ;      a fixed constant (BODY_SIZE = 213 bytes, matching the v303 ROM).
                                     34 ;   2. INIT probes GRPH-key. If GRPH is held, send 0x04 on 0x7FFE -> the
                                     35 ;      firmware swaps to the user cart and reboots the MSX into the game.
                                     36 ;   3. Otherwise, set 32-column screen, palette, sprite cursor, then loop:
                                     37 ;      read 0x7FFF, print whatever the firmware puts there, poll keyboard
                                     38 ;      and forward each keystroke on 0x7FFD.
                                     39 ;-------------------------------------------------------------------------------
                                     40 
                                     41         .module terminal
                                     42 
                                     43 ;-------------------------------------------------------------------------------
                                     44 ; Empty _DATA area. sdcc's linker emits a spurious
                                     45 ; "No definition of area _DATA" warning (which it returns exit code 1
                                     46 ; for) when a standalone asm binary has no .data section. Declaring an
                                     47 ; empty area here silences both the warning and the exit code without
                                     48 ; affecting the binary output.
                                     49 ;-------------------------------------------------------------------------------
                                     50         .area _DATA
      000000                         51         .ds 1
                                     52 
                                     53 ;-------------------------------------------------------------------------------
                                     54 ; ROM header - "AB" + INIT pointer, then ID/version strings.
                                     55 ;-------------------------------------------------------------------------------
                                     56         .area   _HEADER (ABS)
      004000                         57         .org    0x4000
                                     58 
                                     59         ;; --- MSX ROM header (16 bytes) ---
      004000 41 42                   60         .db     0x41, 0x42              ; 'A' 'B' cartridge ID
      004002r10r40                   61         .dw     init                    ; INIT: auto-start entry point
      004004 00 00                   62         .dw     0x0000                  ; STATEMENT
      004006 00 00                   63         .dw     0x0000                  ; DEVICE
      004008 00 00                   64         .dw     0x0000                  ; TEXT
      00400A 00 00 00 00 00 00       65         .dw     0x0000, 0x0000, 0x0000  ; reserved
                                     66 
                                     67         ;; --- INIT body at 0x4010 ---
                                     68         ;; The MSX BIOS calls init() during ROM probing. init() copies
                                     69         ;; a fixed-size body (BODY_SIZE bytes) from ROM to MSX RAM at
                                     70         ;; 0xE000, then JP into RAM. Same trick as v303 - the cart may
                                     71         ;; swap itself out for the user's cart image before we are done
                                     72         ;; printing, so we run from RAM.
      004010                         73         .org    0x4010
      004010                         74 init:
                                     75         ;; Probe GRPH key. If held, return to the BIOS so the MSX
                                     76         ;; drops to BASIC / old loader (no terminal menu visible).
                                     77         ;; If NOT held, copy the body to MSX RAM and enter the
                                     78         ;; terminal menu.
      004010 3E 06            [ 7]   79         ld      a, #6
      004012 CD 41 01         [17]   80         call    0x0141                  ; GTSIZE - row 6 of matrix
      004015 E6 04            [ 7]   81         and     #0x04                   ; GRPH = bit 2 of row 6
      004017 C0               [11]   82         ret     nz                       ; held -> BIOS continues slot probe
                                     83         ;; GRPH not held: continue with body copy + run
      004018 21r26r40         [10]   84         ld      hl, #body              ; source in ROM
      00401B 11 00 E0         [10]   85         ld      de, #0xE000            ; destination in MSX RAM
      00401E 01 8E 00         [10]   86         ld      bc, #BODY_SIZE         ; byte count
      004021 ED B0            [21]   87         ldir
      004023 C3 00 E0         [10]   88         jp      0xE000                 ; jump into the relocated copy
                                     89 
                                     90 ;-------------------------------------------------------------------------------
                                     91 ; Body to copy to RAM. Same shape as v303: GRPH-probe, screen setup,
                                     92 ; poll-FIFO + forward-keyboard loop, ROM_START path.
                                     93 ;
                                     94 ; IMPORTANT: do NOT use .org here - let the assembler place body right
                                     95 ; after the init code. The .org 0x401D in the previous version collided
                                     96 ; with the trailing byte of the JP 0xE000 instruction (3 bytes ending
                                     97 ; at 0x401D), so body actually got placed at 0x401E while LDIR still
                                     98 ; pointed at 0x401D - that one-byte offset meant the RAM copy started
                                     99 ; with the trailing E0 of the JP, which Z80 decodes as RET PO. RET PO
                                    100 ; sometimes returns to a random stack address, which is exactly the
                                    101 ; "rubbish on screen / doesn't drop to BASIC" symptom. Letting the
                                    102 ; assembler place body sequentially keeps the LDIR source correct.
                                    103 ;-------------------------------------------------------------------------------
      004026                        104 body:
                                    105         ;; GRPH-key probe is DISABLED: the v303 CALL #141 (GTSIZE)
                                    106         ;; behaviour is model-dependent (Panasonic returns GRPH bit,
                                    107         ;; some clones always return 0x04). When the firmware treated
                                    108         ;; that as "boot the OLD loader", the terminal would silently
                                    109         ;; disappear on affected hardware with no recovery path. The
                                    110         ;; terminal menu is now always shown; the user picks the OLD
                                    111         ;; loader from the menu by pressing F. Just initialise the
                                    112         ;; screen + cursor and enter the main loop.
                                    113 
                                    114         ;; Set 32-column screen, palette, sprite cursor.
      004026 3E 20            [ 7]  115         ld      a, #32
      004028 32 AF F3         [13]  116         ld      (0xF3AF), a
      00402B 21 0F 00         [10]  117         ld      hl, #0x000F
      00402E 22 EA F3         [16]  118         ld      (0xF3EA), hl
      004031 22 E9 F3         [16]  119         ld      (0xF3E9), hl
      004034 3E 01            [ 7]  120         ld      a, #1
      004036 CD 5F 00         [17]  121         call    0x005F
      004039 21rF0r40         [10]  122         ld      hl, #arrow
      00403C 11 00 38         [10]  123         ld      de, #0x3800
      00403F 01 08 00         [10]  124         ld      bc, #8
      004042 CD 5C 00         [17]  125         call    0x005C
      004045 3E 08            [ 7]  126         ld      a, #8
      004047 21 03 1B         [10]  127         ld      hl, #0x1B03
      00404A CD 4D 00         [17]  128         call    0x004D
                                    129 
      00404D                        130 loop:
                                    131         ;; Poll firmware FIFO at 0x7FFF.
      00404D 3A FF 7F         [13]  132         ld      a, (0x7FFF)
      004050 FE 03            [ 7]  133         cp      #3
      004052 28 2B            [12]  134         jr      z, rom_start            ; "boot the cart"
      004054 FE 04            [ 7]  135         cp      #4
      004056 28 14            [12]  136         jr      z, sprite               ; "move the cursor"
      004058 A7               [ 4]  137         and     a
      004059 CCrA9r40         [17]  138         call    z, wait                 ; empty -> wait one refresh
      00405C C4 A2 00         [17]  139         call    nz, 0x00A2              ; non-empty -> CHPUT (BIOS print)
                                    140         ;; Poll keyboard and forward on 0x7FFD.
      00405F CD 9C 00         [17]  141         call    0x009C                  ; CHSNS - any key?
      004062 28 E9            [12]  142         jr      z, loop
      004064 CD 9F 00         [17]  143         call    0x009F                  ; CHGET - read key
      004067 32 FD 7F         [13]  144         ld      (0x7FFD), a
      00406A 18 E1            [12]  145         jr      loop
                                    146 
      00406C                        147 sprite:
      00406C 3A FF 7F         [13]  148         ld      a, (0x7FFF)             ; X
      00406F 21 01 1B         [10]  149         ld      hl, #0x1B01
      004072 CD 4D 00         [17]  150         call    0x004D
      004075 3A FF 7F         [13]  151         ld      a, (0x7FFF)             ; Y
      004078 3D               [ 4]  152         dec     a
      004079 2D               [ 4]  153         dec     l
      00407A CD 4D 00         [17]  154         call    0x004D
      00407D 18 CE            [12]  155         jr      loop
                                    156 
      00407F                        157 rom_start:
      00407F CDrA9r40         [17]  158         call    wait
      004082 CDrA9r40         [17]  159         call    wait                    ; >= 20 ms for firmware to settle
      004085 2A B1 F6         [16]  160         ld      hl, (0xF6B1)
      004088 11 F4 FF         [10]  161         ld      de, #-12
      00408B 19               [11]  162         add     hl, de
      00408C E5               [11]  163         push    hl
      00408D 5E               [ 7]  164         ld      e, (hl)
      00408E 23               [ 6]  165         inc     hl
      00408F 56               [ 7]  166         ld      d, (hl)
      004090 21 A3 7D         [10]  167         ld      hl, #0x7DA3
      004093 E7               [11]  168         rst     #0x20                   ; COMPARE HL, DE (BIOS helper)
      004094 E1               [10]  169         pop     hl
      004095 20 0C            [12]  170         jr      nz, unknown
      004097 11r9Er40         [10]  171         ld      de, #ugly_patch
      00409A 73               [ 7]  172         ld      (hl), e
      00409B 23               [ 6]  173         inc     hl
      00409C 72               [ 7]  174         ld      (hl), d
      00409D C9               [10]  175         ret
                                    176 
      00409E                        177 ugly_patch:
      00409E C1               [10]  178         pop     bc
      00409F E1               [10]  179         pop     hl
      0040A0 C3 84 7D         [10]  180         jp      0x7D84
                                    181 
      0040A3                        182 unknown:
      0040A3 1E 52            [ 7]  183         ld      e, #'R'
      0040A5 CD B1 FF         [17]  184         call    0xFFB1
      0040A8 C7               [11]  185         rst     0
                                    186 
      0040A9                        187 wait:
      0040A9 F5               [11]  188         push    af
      0040AA FB               [ 4]  189         ei
      0040AB 21 9E FC         [10]  190         ld      hl, #0xFC9E             ; JIFFY
      0040AE 7E               [ 7]  191         ld      a, (hl)
      0040AF                        192 wait_loop:
      0040AF BE               [ 7]  193         cp      (hl)
      0040B0 28 FD            [12]  194         jr      z, wait_loop
      0040B2 F1               [10]  195         pop     af
      0040B3 C9               [10]  196         ret
      0040B4                        197 body_end:
                                    198 
                           00008E   199 BODY_SIZE = body_end - body
                                    200 
                                    201 ;-------------------------------------------------------------------------------
                                    202 ; Cursor arrow sprite pattern - sits just past the relocated body.
                                    203 ;-------------------------------------------------------------------------------
      0040F0                        204         .org    0x40F0
      0040F0                        205 arrow:
      0040F0 20                     206         .db     0b00100000
      0040F1 30                     207         .db     0b00110000
      0040F2 38                     208         .db     0b00111000
      0040F3 3C                     209         .db     0b00111100
      0040F4 38                     210         .db     0b00111000
      0040F5 30                     211         .db     0b00110000
      0040F6 20                     212         .db     0b00100000
      0040F7 00                     213         .db     0b00000000
