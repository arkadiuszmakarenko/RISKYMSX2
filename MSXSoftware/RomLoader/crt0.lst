                                      1 ;-------------------------------------------------------------------------------
                                      2 ; crt0.s - C runtime startup for the RISKYMSX2 ROM LOADER cartridge.
                                      3 ;
                                      4 ; The loader now starts like a normal MSX ROM cartridge, like
                                      5 ; MSXSoftware/HelloWorld/hello.bin:
                                      6 ;   0x4000  "AB" MSX ROM header, INIT -> init
                                      7 ;   0x4020  direct entry stub: call _main
                                      8 ;
                                      9 ; The ROM runs directly from flash and uses the cart mailbox window
                                     10 ; (0x7FF0..0x7FFF) as the shared envelope for USB directory, file and
                                     11 ; mapper data. No copy-to-RAM bootstrap is needed.
                                     12 ;-------------------------------------------------------------------------------
                                     13 
                                     14 	.module crt0
                                     15 
                                     16 	.area	_HEADER (ABS)
                                     17 
      004000                         18 	.org	0x4000
                                     19 
                                     20 	;; --- MSX ROM header (16 bytes) ---
      004000 41 42                   21 	.db	0x41, 0x42		; 'A' 'B' cartridge ID
      004002r10r40                   22 	.dw	init			; INIT: auto-start entry point
      004004 00 00                   23 	.dw	0x0000			; STATEMENT
      004006 00 00                   24 	.dw	0x0000			; DEVICE
      004008 00 00                   25 	.dw	0x0000			; TEXT
      00400A 00 00 00 00 00 00       26 	.dw	0x0000, 0x0000, 0x0000	; reserved
                                     27 
                                     28 	;; --- direct entry stub (0x4010) ---
                                     29 	;; The 16-byte MSX ROM header lives at 0x4000..0x400F. The C code
                                     30 	;; area (_CODE) starts at 0x4020, so the entry stub must NOT be
                                     31 	;; at 0x4020 or it will be overwritten by _set_screen (the first
                                     32 	;; C function) when makebin packs the IHX. Place it at 0x4010
                                     33 	;; (right after the header, before _CODE at 0x4020) and update
                                     34 	;; the header's INIT vector to match. SDCC resolves the .dw
                                     35 	;; reference at link time, so we just need a label here.
      004010                         36 	.org	0x4010
      004010                         37 init:
      004010 F3               [ 4]   38 	di
      004011 CDr00r00         [17]   39 	call	_main
      004014 F3               [ 4]   40 	di
      004015 76               [ 4]   41 	halt
      004016 C9               [10]   42 	ret
