                                      1 ;-------------------------------------------------------------------------------
                                      2 ; crt0.s - envelope-test cartridge startup.
                                      3 ;
                                      4 ; Layout (mirrors the working hello.bin / fixed selector ROM):
                                      5 ;   0x4000  "AB" header, INIT -> 0x4010
                                      6 ;   0x4010  DI / CALL _main / DI / HALT / RET
                                      7 ;   0x4020  C code starts here
                                      8 ;
                                      9 ; The entry stub is intentionally NOT at 0x4020: SDCC's --code-loc 0x4020
                                     10 ; starts _CODE at 0x4020, so any stub there gets overwritten by the first
                                     11 ; C function when makebin packs overlapping IHX records.  hello.bin's
                                     12 ; stub at 0x4010 survives because it lives between the header and _CODE.
                                     13 ;-------------------------------------------------------------------------------
                                     14 
                                     15 	.module crt0
                                     16 	.globl	_main
                                     17 
                                     18 	.area	_HEADER (ABS)
                                     19 
      004000                         20 	.org	0x4000
                                     21 
                                     22 	;; --- MSX ROM header (16 bytes) ---
      004000 41 42                   23 	.db	0x41, 0x42		; 'A' 'B' cartridge ID
      004002r10r40                   24 	.dw	init			; INIT -> 0x4010 (resolved at link time)
      004004 00 00                   25 	.dw	0x0000			; STATEMENT
      004006 00 00                   26 	.dw	0x0000			; DEVICE
      004008 00 00                   27 	.dw	0x0000			; TEXT
      00400A 00 00 00 00 00 00       28 	.dw	0x0000, 0x0000, 0x0000	; reserved
                                     29 
                                     30 	;; --- direct entry stub at 0x4010 (between header and _CODE) ---
      004010                         31 	.org	0x4010
      004010                         32 init:
      004010 F3               [ 4]   33 	di
      004011 CDr00r00         [17]   34 	call	_main
      004014 F3               [ 4]   35 	di
      004015 76               [ 4]   36 	halt
      004016 C9               [10]   37 	ret
